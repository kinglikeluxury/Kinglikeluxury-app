# ================================================================
# KINGLIKE LUXURY REAL ESTATE — Environment Variables Template
# Date: 2026-05-26
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ================================================================

# ── Database ────────────────────────────────────────────────────
# Primary database connection (Neon PostgreSQL — pooler URL)
# Current production: ep-young-forest-aq74bptf-pooler.c-8.us-east-1.aws.neon.tech
NEON_DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@<HOST>/neondb?sslmode=require

# Replit-managed Neon database (same as NEON_DATABASE_URL in current config)
DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@<HOST>/neondb?sslmode=require

# ── Session ─────────────────────────────────────────────────────
# Strong random secret for Express session signing (min 32 chars)
SESSION_SECRET=<GENERATE_WITH: openssl rand -base64 48>

# ── Cloudinary (image / video / audio / blog media uploads) ─────
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=<YOUR_RESEND_API_KEY>

# ── AI / OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
AI_API_KEY=<YOUR_AI_API_KEY>

# ── SMS / WhatsApp (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=<YOUR_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<YOUR_TWILIO_PHONE_NUMBER>
TWILIO_MESSAGING_SERVICE_SID=<YOUR_TWILIO_MESSAGING_SERVICE_SID>

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<YOUR_VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:info@kinglikeluxury.com

# ── Payment Gateway (BOG) ────────────────────────────────────────
BOG_CLIENT_ID=<YOUR_BOG_CLIENT_ID>
BOG_CLIENT_SECRET=<YOUR_BOG_CLIENT_SECRET>
BOG_BASE_URL=https://api.bog.ge

# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=production
